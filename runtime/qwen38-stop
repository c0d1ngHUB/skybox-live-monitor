#!/usr/bin/env bash
# Stop Qwen3.8 (NInfer engine) and free the Blackwell.
#
# Hindsight runs on Ollama Cloud; no local backend is started, checked or
# probed here. The priority gateway deliberately stays running (Hermes keeps
# reaching its endpoint through it). Its state is printed and a non-active
# gateway is warned about, but it does not fail the stop: this script also runs
# as automatic recovery after a failed start, where the gateway may never have
# come up, and that must not lock the Skybox button.
#
# The Docker container is bound to the unit: ExecStop runs `docker stop`, and
# --rm removes it. ExecStop/ExecStopPost ignore Docker failures, so this script
# verifies the container's absence itself.
#
# Exit codes: 0 settled, 64 usage, 75 unresolved cleanup
# (the Skybox controller keeps its recovery barrier for 75).
set -uo pipefail

if (( $# )); then
  echo "Usage: qwen38-stop" >&2
  exit 64
fi

if ! systemctl --user stop qwen38-ninfer.service; then
  echo "Qwen stop did not settle." >&2
  exit 75
fi

if ! remaining_container=$(docker container ls --all --filter 'name=^/qwen38-ninfer$' --format '{{.State}}'); then
  echo "Qwen container cleanup cannot be verified." >&2
  exit 75
fi
if [[ -n "$remaining_container" ]]; then
  echo "Qwen container is still present after stop." >&2
  exit 75
fi

rc=0
state=$(systemctl --user is-active qwen38-ninfer.service)
if [[ "$state" == failed ]]; then
  # A failed unit is stopped as well (the container's absence is proven above).
  # Clear the marker so the button reads "stopped" instead of "failed"; if that
  # does not work, failed still counts as settled, as in the Skybox controller.
  systemctl --user reset-failed qwen38-ninfer.service || true
  state=$(systemctl --user is-active qwen38-ninfer.service)
fi
printf '%-26s %s\n' qwen38-ninfer.service "$state"
[[ "$state" == inactive || "$state" == failed ]] || rc=75
state=$(systemctl --user is-active qwen38-gateway.service)
printf '%-26s %s\n' qwen38-gateway.service "$state"
[[ "$state" == active ]] || echo "Warning: qwen38-gateway.service is $state." >&2
exit "$rc"
